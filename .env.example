# ── MongoDB Atlas ─────────────────────────────────────────────
# Cadena de conexión del cluster (Atlas → Connect → Drivers).
# La contraseña debe ir codificada si contiene caracteres especiales.
MONGODB_URI=mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=tecnopoly

# ── JWT ───────────────────────────────────────────────────────
# Genera uno propio:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=genera_tu_propio_secreto_y_nunca_lo_subas_al_repo
JWT_EXPIRES_IN=7d

# ── Admin inicial (npm run seed) ──────────────────────────────
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@tecnopoly.com
SEED_ADMIN_PASSWORD=

# ── App ───────────────────────────────────────────────────────
PORT=8001
NODE_ENV=development
